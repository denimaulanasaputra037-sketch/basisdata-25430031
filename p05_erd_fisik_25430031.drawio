ta ◆&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#0b4a8a&quot;&gt;VARCHAR(15)&lt;/font&gt;&lt;/td&gt;&lt;td&gt;NOT NULL, CHECK angka saja&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;42&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;status_anggota&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#0b4a8a&quot;&gt;ENUM('Aktif','Nonaktif')&lt;/font&gt;&lt;/td&gt;&lt;td&gt;NOT NULL, DEFAULT 'Aktif'&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;42&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;tgl_daftar&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#0b4a8a&quot;&gt;DATE&lt;/font&gt;&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;42&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;id_petugas_daftar&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#0b4a8a&quot;&gt;CHAR(5)&lt;/font&gt;&lt;/td&gt;&lt;td&gt;NOT NULL, → petugas&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=#222222;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="35" y="294" width="560" height="186" as="geometry" /></mxCell><mxCell id="t_peminjaman" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;4&quot; bgcolor=&quot;#0F7B5F&quot;&gt;&lt;font color=&quot;#ffffff&quot;&gt;&lt;b&gt;peminjaman&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;42&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;no_peminjaman&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#0b4a8a&quot;&gt;CHAR(5)&lt;/font&gt;&lt;/td&gt;&lt;td&gt;NOT NULL, CHECK 'PM'+3 digit&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;42&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;tgl_peminjaman&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#0b4a8a&quot;&gt;DATE&lt;/font&gt;&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;42&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;tgl_jatuh_tempo&lt;