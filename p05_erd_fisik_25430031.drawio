<mxfile><diagram name="ERD fisik" id="erdfisik"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t_petugas" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;4&quot; bgcolor=&quot;#2563A8&quot;&gt;&lt;font color=&quot;#ffffff&quot;&gt;&lt;b&gt;petugas&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;42&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;id_petugas&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#0b4a8a&quot;&gt;CHAR(5)&lt;/font&gt;&lt;/td&gt;&lt;td&gt;NOT NULL, CHECK 'PT'+3 digit&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;42&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;nama_petugas&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#0b4a8a&quot;&gt;VARCHAR(100)&lt;/font&gt;&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=#222222;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="777" y="70" width="560" height="74" as="geometry" /></mxCell><mxCell id="t_buku" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;4&quot; bgcolor=&quot;#8B5A14&quot;&gt;&lt;font color=&quot;#ffffff&quot;&gt;&lt;b&gt;buku&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;42&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;kode_buku&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#0b4a8a&quot;&gt;CHAR(5)&lt;/font&gt;&lt;/td&gt;&lt;td&gt;NOT NULL, CHECK 'BK'+3 digit (AB-10)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;42&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;judul_buku&lt;/td&gt;&lt;td&gt;&lt;font color=&quot;#0b4a8a&quot;&gt;VARCHAR(150)&lt;/font&gt;&lt;/td&gt;&lt;td&gt;NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td width=&quot;42&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/td